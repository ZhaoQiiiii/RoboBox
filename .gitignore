logs/
*.log
/bbox_result.json
/.runtime-state.json
# 场景数据默认不入库，只保留目录占位
scenes/*
!scenes/.gitkeep
# Web 编辑器默认场景目录
/tools/3D-Toolbox/scenes/*
!/tools/3D-Toolbox/scenes/.gitkeep


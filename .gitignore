# 依赖与构建产物
node_modules/
/tools/3D-Toolbox/frontend/dist/
/tools/3D-Toolbox/package-lock.json

# ==================== 传感器工具构建 / 测试产物 ====================
# C++ CMake / CTest
/tools/*/build/
Testing/
__pycache__/
*.py[cod]
# LidarRender 测试生成的点云
/tools/LidarRender/tests/data/
# 内置 rerun 源码的测试素材（约 660MB），不入库
